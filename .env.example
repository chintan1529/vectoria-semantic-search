# Vectoria Backend Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env and fill in your API keys

# LLM Provider
# ----------------------------------------
VECTORIA_LLM_API_KEY=your-gemini-api-key-here
VECTORIA_MODEL_NAME=gemini-2.5-flash
VECTORIA_HF_API_KEY=your-huggingface-api-key-here

# Retrieval Settings
# ----------------------------------------
VECTORIA_TOP_K_DEFAULT=5
VECTORIA_MAX_CONTEXT_TOKENS=4000

# Server & Security
# ----------------------------------------
# Comma-separated list of allowed origins. Use "*" for development.
VECTORIA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
